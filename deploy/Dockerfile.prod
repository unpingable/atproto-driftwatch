FROM python:3.11-slim@sha256:9534e5a8e315485d4061ed659af0fd78a284c015f9b73661b41d6bab25604534
WORKDIR /app

ARG GIT_SHA=unknown
ARG RELEASE_VERSION=0.1.0rc1
ENV GIT_SHA=${GIT_SHA}
LABEL org.opencontainers.image.revision=${GIT_SHA} \
      org.opencontainers.image.version=${RELEASE_VERSION} \
      org.opencontainers.image.source="https://github.com/unpingable/atproto-driftwatch"
ENV PYTHONDONTWRITEBYTECODE=1

COPY deploy/requirements.prod.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./

EXPOSE 8000
CMD ["uvicorn", "labeler.main:app", "--host", "0.0.0.0", "--port", "8000"]
