{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project.observation-binding/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "producer", "output_schema", "kind", "argv"],
  "properties": {
    "schema": {"const": "project.observation-binding/v1"},
    "producer": {"type": "string", "minLength": 1},
    "output_schema": {"const": "project.ops.status/v1"},
    "kind": {"const": "exec/v1"},
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "environment": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    }
  }
}
