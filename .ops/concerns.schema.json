{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project.concerns/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project", "concerns"],
  "properties": {
    "schema": {"const": "project.concerns/v1"},
    "project": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$"},
    "concerns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "profile", "required", "description"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$"},
          "question": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$"},
          "profile": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$"},
          "required": {"type": "boolean"},
          "description": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
